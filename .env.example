# Switch 遊戲比價 — 環境變數範本
# 複製成 .env.local 後填入真實值。不要把真實值 commit 進 git。
# 注意：Supabase 專案還不存在時，留空或填 placeholder 也可以 npm run build，
# 資料頁面會顯示「尚無資料」，不會在建置時失敗。

# Supabase（公開，瀏覽器可用）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase（伺服器端專用，絕對不要放進前端程式碼或公開）
SUPABASE_SERVICE_ROLE_KEY=

# 網站公開網址（登入回跳用，例如 https://switch-price.vercel.app）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 每日 08:00 重新整理價格的 cron 保護金鑰（資料組 / 登入組用）
CRON_SECRET=
